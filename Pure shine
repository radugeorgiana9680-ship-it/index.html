<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#fff7fb">
<title>Pure Shine Cleaning Manager</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Parisienne&display=swap" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jspdf/2.5.1/jspdf.umd.min.js"></script>

<style>
:root {
  --pink: #e92b78;
  --pink-soft: #fbe8f1;
  --pink-bg: #fff7fb;
  --purple: #eee1f8;
  --blue: #dff1fc;
  --green: #def2df;
  --yellow: #fff0c9;
  --text: #48434c;
  --muted: #89818b;
  --border: #ead8e1;
  --nav: 78px;
  --text-scale: 1;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html { font-size: 16px; }

body {
  margin: 0;
  background: var(--pink-bg);
  color: var(--text);
  font-family: "DM Sans", Arial, sans-serif;
  overflow-x: hidden;
}

body.high-contrast {
  --text: #171217;
  --muted: #423942;
  --border: #9d7187;
  --pink-bg: #fff;
  --pink-soft: #f8d9e7;
}

body.larger-text { --text-scale: 1.2; }

button, input, select, textarea { font: inherit; }
button { cursor: pointer; }
button:active { transform: scale(.98); }

.app {
  width: 100%;
  min-height: 100vh;
  padding-bottom: calc(var(--nav) + env(safe-area-inset-bottom));
}

.header {
  position: sticky;
  top: 0;
  z-index: 50;
  background: #fffafd;
  border-bottom: 1px solid #f1dce5;
  padding: 12px 18px;
}

.header-inner {
  max-width: 1100px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 10px;
}

.brand { display: flex; align-items: center; gap: 11px; min-width: 0; }

.logo {
  width: 57px;
  height: 57px;
  border-radius: 50%;
  object-fit: cover;
  background: #f6dcea;
  border: 2px solid #f0d4df;
  flex: none;
}

.brand-title {
  font-family: Parisienne, cursive;
  font-size: calc(34px * var(--text-scale));
  line-height: 1;
  color: #211e24;
}

.brand-subtitle {
  color: #8b8189;
  letter-spacing: 1.5px;
  font-size: calc(10px * var(--text-scale));
  margin-top: 5px;
}

.header-actions { display: flex; gap: 6px; }

.header-btn {
  width: 44px;
  height: 44px;
  border-radius: 50%;
  background: #fff;
  border: 1px solid #dfd4da;
  font-size: 22px;
}

.page { display: none; max-width: 1100px; margin: auto; padding: 18px 16px 30px; }
.page.active { display: block; }

.page-title { font-size: calc(29px * var(--text-scale)); font-weight: 800; margin: 8px 0 20px; }

.date-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 23px;
  padding: 16px;
  display: flex;
  align-items: center;
  gap: 14px;
  margin-bottom: 17px;
}

.date-number {
  width: 67px;
  height: 67px;
  border-radius: 19px;
  background: #fce9f2;
  display: grid;
  place-items: center;
  color: var(--pink);
  font-size: calc(31px * var(--text-scale));
  font-weight: 800;
  flex: none;
}

.date-content { flex: 1; min-width: 0; }
.date-day { font-size: calc(21px * var(--text-scale)); font-weight: 800; }
.date-full { color: var(--muted); font-size: calc(13px * var(--text-scale)); margin-top: 4px; }

.stats { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; margin-bottom: 22px; }
.stat { min-height: 105px; border-radius: 20px; padding: 13px; border: 1px solid var(--border); display: flex; flex-direction: column; justify-content: center; min-width: 0; }
.stat.jobs { background: #fdeaf2; }
.stat.hours { background: #e9def8; }
.stat.money { background: #def1df; }
.stat-icon { font-size: 23px; margin-bottom: 6px; }
.stat-label { font-size: calc(10px * var(--text-scale)); font-weight: 800; text-transform: uppercase; letter-spacing: .5px; color: #625a63; }
.stat-value { font-size: calc(21px * var(--text-scale)); font-weight: 800; margin-top: 5px; overflow-wrap: anywhere; }

.section-title { font-size: calc(23px * var(--text-scale)); font-weight: 800; margin: 23px 0 13px; }
.section-title .view { float: right; color: var(--pink); font-size: calc(13px * var(--text-scale)); cursor: pointer; margin-top: 6px; }

.schedule, .clients-list, .history-list { display: grid; gap: 11px; }

.job-card, .client-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 21px;
  padding: 14px;
  box-shadow: 0 3px 12px #8b52700a;
}

.job-main { display: flex; align-items: center; gap: 11px; min-width: 0; }

.job-time {
  width: 91px;
  min-height: 70px;
  border-radius: 16px;
  background: var(--blue);
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  flex: none;
}

.job-time strong { font-size: calc(17px * var(--text-scale)); }
.job-time span { color: #625b65; font-size: calc(12px * var(--text-scale)); margin-top: 4px; }
.job-info { flex: 1; min-width: 0; }
.job-name { font-size: calc(18px * var(--text-scale)); font-weight: 800; overflow-wrap: anywhere; }
.job-type { color: var(--muted); font-size: calc(12px * var(--text-scale)); margin-top: 4px; overflow-wrap: anywhere; }
.job-status { color: #32734e; font-weight: 800; }
.job-money { text-align: right; white-space: nowrap; }
.job-money strong { display: block; font-size: calc(17px * var(--text-scale)); }
.job-money small { color: var(--muted); font-weight: 600; }

.job-actions { display: flex; flex-wrap: wrap; gap: 7px; margin-top: 12px; padding-top: 11px; border-top: 1px solid #f1e4ea; }

.btn { padding: 10px 12px; border-radius: 12px; background: #f8e8ef; color: #88405f; font-weight: 800; font-size: calc(13px * var(--text-scale)); }
.btn.primary { background: var(--pink); color: #fff; }
.btn.green { background: #def1e5; color: #285b3f; }
.btn.pdf { background: #fff0d0; color: #755621; }
.btn.danger { background: #f9dddd; color: #a13e3e; }
.btn.timer { background: #e7ddf7; color: #674882; }

.tomorrow { margin-top: 22px; padding: 16px; border-radius: 23px; background: #f4eafb; border: 1px solid #e3d1ed; }
.tomorrow-title { display: flex; justify-content: space-between; align-items: center; gap: 10px; font-size: calc(21px * var(--text-scale)); font-weight: 800; margin-bottom: 12px; }
.tomorrow-title small { font-size: calc(12px * var(--text-scale)); color: var(--muted); }

.banner { width: 100%; height: auto; min-height: 100px; max-height: 190px; object-fit: cover; border-radius: 22px; margin-top: 23px; display: block; }

.fab {
  position: fixed;
  right: 17px;
  bottom: calc(var(--nav) + 15px);
  z-index: 45;
  width: 58px;
  height: 58px;
  border-radius: 50%;
  background: var(--pink);
  color: #fff;
  font-size: 34px;
  box-shadow: 0 8px 24px #d62b713d;
}

.bottom-nav {
  position: fixed;
  z-index: 40;
  left: 0;
  right: 0;
  bottom: 0;
  height: calc(var(--nav) + env(safe-area-inset-bottom));
  padding: 6px 5px calc(6px + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -5px 25px #a65d7b15;
}

.nav-inner { max-width: 1000px; height: 100%; margin: auto; display: grid; grid-template-columns: repeat(5, 1fr); gap: 3px; }
.nav-btn { background: transparent; color: #777078; border-radius: 15px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 4px; font-weight: 700; font-size: calc(10px * var(--text-scale)); padding: 3px 0; }
.nav-btn span { font-size: calc(21px * var(--text-scale)); line-height: 1; }
.nav-btn.active { background: #fde8f1; color: var(--pink); }

.calendar-toolbar { display: flex; justify-content: space-between; align-items: center; gap: 10px; margin-bottom: 14px; }
.month-title { font-size: calc(20px * var(--text-scale)); font-weight: 800; }
.calendar { background: #fff; border: 1px solid var(--border); border-radius: 20px; padding: 7px; display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 4px; }
.calendar-day-name { text-align: center; color: var(--muted); font-size: calc(10px * var(--text-scale)); font-weight: 800; padding: 5px 0; }
.calendar-day { min-height: 57px; min-width: 0; background: #fff; border: 1px solid #eee1e7; border-radius: 9px; padding: 4px; font-size: calc(10px * var(--text-scale)); cursor: pointer; overflow: hidden; }
.calendar-day.today { border: 2px solid var(--pink); }
.calendar-day.has-job { background: #fceaf2; }
.calendar-day.holiday { background: #e9def7; }
.calendar-day-number { font-weight: 800; font-size: calc(12px * var(--text-scale)); }
.calendar-job-dot { margin-top: 3px; color: #85415e; font-weight: 700; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }

.client-card { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
.client-avatar { width: 48px; height: 48px; border-radius: 50%; background: #f5dce8; color: #a24e72; display: grid; place-items: center; font-size: 21px; font-weight: 800; flex: none; }
.client-info { flex: 1; min-width: 140px; }
.client-name { font-size: calc(18px * var(--text-scale)); font-weight: 800; }
.client-details { color: var(--muted); font-size: calc(12px * var(--text-scale)); margin-top: 4px; overflow-wrap: anywhere; }
.client-actions { display: flex; gap: 6px; flex-wrap: wrap; }

.earning-summary { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 9px; margin-bottom: 20px; }
.earning-box { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 14px; min-width: 0; }
.earning-box span { color: var(--muted); font-size: calc(12px * var(--text-scale)); }
.earning-box strong { display: block; color: var(--pink); font-size: calc(22px * var(--text-scale)); margin-top: 7px; overflow-wrap: anywhere; }

.settings { display: grid; gap: 10px; }
.settings-section { margin-top: 12px; color: #a05475; font-size: calc(12px * var(--text-scale)); font-weight: 800; text-transform: uppercase; letter-spacing: 1px; }
.setting { background: #fff; border: 1px solid var(--border); border-radius: 18px; padding: 13px; display: flex; align-items: center; gap: 10px; min-height: 70px; }
.setting-icon { width: 39px; height: 39px; border-radius: 12px; background: #fae4ed; display: grid; place-items: center; font-size: 20px; flex: none; }
.setting-main { flex: 1; min-width: 0; }
.setting-title { font-size: calc(14px * var(--text-scale)); font-weight: 800; }
.setting-desc { color: var(--muted); font-size: calc(11px * var(--text-scale)); margin-top: 3px; line-height: 1.4; }
.switch { width: 48px; height: 29px; border-radius: 30px; background: #d5d3d5; padding: 3px; flex: none; }
.switch i { display: block; width: 23px; height: 23px; background: #fff; border-radius: 50%; box-shadow: 0 2px 5px #0002; transition: .2s; }
.switch.on { background: var(--pink); }
.switch.on i { transform: translateX(19px); }
.range { width: 105px; min-width: 75px; accent-color: var(--pink); }
.range-value { color: var(--pink); font-weight: 800; min-width: 43px; text-align: right; font-size: calc(12px * var(--text-scale)); }
.select { border: 1px solid var(--border); background: #fff8fb; border-radius: 10px; padding: 9px; color: #6f5965; font-weight: 700; max-width: 145px; min-width: 0; }

.empty { background: #fff; border: 1px dashed var(--border); border-radius: 20px; padding: 25px; text-align: center; color: var(--muted); }
.modal-bg { position: fixed; inset: 0; z-index: 100; background: #1f152099; display: none; align-items: flex-end; }
.modal-bg.show { display: flex; }
.modal { width: 100%; max-width: 700px; max-height: 92vh; overflow: auto; margin: auto; background: #fff; border-radius: 25px 25px 0 0; padding: 20px; }
.modal-handle { width: 45px; height: 5px; background: #ddd; border-radius: 10px; margin: 0 auto 15px; }
.modal h2 { margin: 0 0 17px; font-size: calc(23px * var(--text-scale)); }
.form { display: grid; gap: 12px; }
.form label { color: #68616a; font-size: calc(12px * var(--text-scale)); font-weight: 700; }
.form input, .form select, .form textarea { display: block; width: 100%; margin-top: 5px; border: 1px solid #dfd4da; border-radius: 12px; padding: 11px; background: #fff; color: #3e3940; outline: none; }
.form textarea { min-height: 75px; resize: vertical; }
.form-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
.modal-buttons { display: flex; gap: 8px; margin-top: 17px; }
.modal-buttons .btn { flex: 1; }
.timer-panel { background: #eee0f7; border-radius: 20px; padding: 18px; margin-bottom: 15px; text-align: center; }
.timer-client { font-size: calc(20px * var(--text-scale)); font-weight: 800; }
.timer-time { font-size: 40px; font-weight: 800; margin: 10px 0; color: #51494f; }
.toast { position: fixed; left: 50%; bottom: calc(var(--nav) + 17px); transform: translateX(-50%); background: #332c33; color: #fff; padding: 11px 16px; border-radius: 13px; z-index: 200; font-weight: 700; display: none; max-width: 90%; text-align: center; }

@media(min-width:700px) {
  .page { padding: 24px 28px 40px; }
  .job-time { width: 120px; }
}

@media(max-width:380px) {
  .brand-title { font-size: 29px; }
  .brand-subtitle { display: none; }
  .logo { width: 47px; height: 47px; }
  .header-btn { width: 39px; height: 39px; }
  .stats { grid-template-columns: 1fr 1fr; }
  .earning-summary { grid-template-columns: 1fr; }
  .job-money { display: none; }
  .setting { flex-wrap: wrap; }
  .setting-main { min-width: 130px; }
  .range { flex: 1; }
  .form-row { grid-template-columns: 1fr; }
}
</style>
</head>

<body>
<div class="app">

<header class="header">
  <div class="header-inner">
    <div class="brand">
      <img id="logo" class="logo" alt="Pure Shine Cleaning logo">
      <div>
        <div class="brand-title">Pure Shine Cleaning</div>
        <div class="brand-subtitle">PROFESSIONAL CLEANING</div>
      </div>
    </div>
    <div class="header-actions">
      <button class="header-btn" onclick="openReminder()" aria-label="Client reminder">🔔</button>
      <button class="header-btn" onclick="showPage('settings')" aria-label="Settings">⚙️</button>
    </div>
  </div>
</header>

<section id="home" class="page active">
  <div class="date-card">
    <div class="date-number" id="dateNumber"></div>
    <div class="date-content">
      <div class="date-day" id="dateDay"></div>
      <div class="date-full" id="dateFull"></div>
    </div>
    <div style="font-size:28px">📅</div>
  </div>

  <div class="stats">
    <div class="stat jobs"><div class="stat-icon">🧹</div><div class="stat-label">Completed jobs</div><div class="stat-value" id="statJobs">0</div></div>
    <div class="stat hours"><div class="stat-icon">⏱️</div><div class="stat-label">Worked</div><div class="stat-value" id="statHours">0m</div></div>
    <div class="stat money"><div class="stat-icon">💷</div><div class="stat-label">Earned</div><div class="stat-value" id="statMoney">£0.00</div></div>
  </div>

  <div id="activeTimerHome"></div>

  <div class="section-title">Today's Schedule <span class="view" onclick="showPage('schedule')">View all →</span></div>
  <div id="todaySchedule" class="schedule"></div>
  <div id="tomorrowSection"></div>
  <img id="banner" class="banner" alt="Pure Shine Cleaning banner">
</section>

<section id="schedule" class="page">
  <div class="page-title">Schedule</div>
  <div class="calendar-toolbar">
    <button class="btn" onclick="changeMonth(-1)">‹ Previous</button>
    <div class="month-title" id="monthTitle"></div>
    <button class="btn" onclick="changeMonth(1)">Next ›</button>
  </div>
  <div id="calendar" class="calendar"></div>
  <div class="section-title" id="scheduleDayTitle">Today's Jobs</div>
  <div id="scheduleJobs" class="schedule"></div>
</section>

<section id="clients" class="page">
  <div class="page-title">Clients</div>
  <button class="btn primary" style="width:100%;margin-bottom:15px" onclick="openClientModal()">＋ Add Client</button>
  <div id="clientsList" class="clients-list"></div>
</section>

<section id="earnings" class="page">
  <div class="page-title">Earnings</div>
  <div class="earning-summary">
    <div class="earning-box"><span>Completed</span><strong id="totalEarned">£0.00</strong></div>
    <div class="earning-box"><span>Paid</span><strong id="totalPaid">£0.00</strong></div>
    <div class="earning-box"><span>Owed</span><strong id="totalOwed">£0.00</strong></div>
  </div>
  <div class="section-title">Completed Jobs</div>
  <div id="history" class="history-list"></div>
</section>

<section id="settings" class="page">
  <div class="page-title">Settings</div>
  <div class="settings">

    <div class="settings-section">Appearance</div>

    <div class="setting">
      <div class="setting-icon">🔍</div>
      <div class="setting-main"><div class="setting-title">Zoom / App Size</div><div class="setting-desc">Enlarge or reduce the interface.</div></div>
      <input id="scaleRange" class="range" type="range" min="0.8" max="2" step="0.05" value="1">
      <div class="range-value" id="scaleValue">100%</div>
    </div>

    <div class="setting">
      <div class="setting-icon">🔠</div>
      <div class="setting-main"><div class="setting-title">Larger Text</div><div class="setting-desc">Make labels and text easier to read.</div></div>
      <button id="largerTextSwitch" class="switch" onclick="toggleSetting('largerText')" aria-label="Toggle larger text"><i></i></button>
    </div>

    <div class="setting">
      <div class="setting-icon">◐</div>
      <div class="setting-main"><div class="setting-title">High Contrast</div><div class="setting-desc">Darken text and borders for readability.</div></div>
      <button id="contrastSwitch" class="switch" onclick="toggleSetting('highContrast')" aria-label="Toggle high contrast"><i></i></button>
    </div>

    <div class="setting">
      <div class="setting-icon">🎨</div>
      <div class="setting-main"><div class="setting-title">Accent Colour</div><div class="setting-desc">Change the main pink colour.</div></div>
      <input type="color" id="accentColor" style="width:44px;height:38px;border:0;background:none">
    </div>

    <div class="settings-section">Business</div>

    <div class="setting">
      <div class="setting-icon">🏠</div>
      <div class="setting-main"><div class="setting-title">Business Name</div><div class="setting-desc">Displayed on invoices.</div></div>
      <input id="businessName" class="select" aria-label="Business name">
    </div>

    <div class="setting">
      <div class="setting-icon">👤</div>
      <div class="setting-main"><div class="setting-title">Owner Name</div><div class="setting-desc">Displayed on invoices.</div></div>
      <input id="ownerName" class="select" aria-label="Owner name">
    </div>

    <div class="settings-section">Notifications</div>

    <div class="setting">
      <div class="setting-icon">🔔</div>
      <div class="setting-main"><div class="setting-title">Evening Reminder</div><div class="setting-desc">Enable the evening-before reminder preference.</div></div>
      <button id="reminderSwitch" class="switch" onclick="toggleSetting('reminders')" aria-label="Toggle reminders"><i></i></button>
    </div>

    <div class="setting">
      <div class="setting-icon">💷</div>
      <div class="setting-main"><div class="setting-title">Payment Reminders</div><div class="setting-desc">Show options for unpaid jobs.</div></div>
      <button id="paymentSwitch" class="switch" onclick="toggleSetting('paymentReminders')" aria-label="Toggle payment reminders"><i></i></button>
    </div>

    <div class="settings-section">Schedule</div>

    <div class="setting">
      <div class="setting-icon">🔄</div>
      <div class="setting-main"><div class="setting-title">Fortnightly Rotation</div><div class="setting-desc">Alternates Sindu and Joanna on Fridays, starting with Sindu on 9 October 2026.</div></div>
      <button id="fortnightlySwitch" class="switch" onclick="toggleSetting('fortnightly')" aria-label="Toggle fortnightly rotation"><i></i></button>
    </div>

    <div class="setting">
      <div class="setting-icon">⏰</div>
      <div class="setting-main"><div class="setting-title">Working Day</div><div class="setting-desc">Used for planning availability.</div></div>
      <select id="workingHours" class="select"><option value="6">6 hours</option><option value="8">8 hours</option><option value="10">10 hours</option><option value="12">12 hours</option></select>
    </div>

    <div class="settings-section">Photos</div>

    <div class="setting">
      <div class="setting-icon">🖼️</div>
      <div class="setting-main"><div class="setting-title">App Icon / Logo</div><div class="setting-desc">Upload the icon image you want to use in the app.</div></div>
      <input id="logoUpload" type="file" accept="image/*" aria-label="Upload app logo">
    </div>

    <div class="setting">
      <div class="setting-icon">🌸</div>
      <div class="setting-main"><div class="setting-title">Home Banner</div><div class="setting-desc">Upload a banner for the home screen.</div></div>
      <input id="bannerUpload" type="file" accept="image/*" aria-label="Upload home banner">
    </div>

    <button class="btn primary" style="width:100%;padding:15px" onclick="saveSettings()">💾 Save Settings</button>
  </div>
</section>

</div>

<button class="fab" onclick="openJobModal()" aria-label="Add job">＋</button>

<nav class="bottom-nav">
  <div class="nav-inner">
    <button id="nav-home" class="nav-btn active" onclick="showPage('home')"><span>⌂</span>Home</button>
    <button id="nav-schedule" class="nav-btn" onclick="showPage('schedule')"><span>📅</span>Schedule</button>
    <button id="nav-clients" class="nav-btn" onclick="showPage('clients')"><span>👥</span>Clients</button>
    <button id="nav-earnings" class="nav-btn" onclick="showPage('earnings')"><span>£</span>Earnings</button>
    <button id="nav-settings" class="nav-btn" onclick="showPage('settings')"><span>⚙️</span>Settings</button>
  </div>
</nav>

<div id="modalBg" class="modal-bg" onclick="closeModalOutside(event)"><div class="modal" id="modal"></div></div>
