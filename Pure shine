<text x="850" y="355" font-size="85">🧹</text><text x="1030" y="370" font-size="80">🫧</text>
</svg>`);

const DAYS = ["Sunday","Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"];
const ROTATION_REFERENCE = "2026-10-09";

const DEFAULT_CLIENTS = [
  {id:"lottie",name:"Lottie",phone:"07788 447015",type:"Agency",rate:16,day:"Monday",start:"09:00",hours:2,frequency:"weekly",active:true},
  {id:"victoria",name:"Victoria",phone:"07923 054040",type:"Agency",rate:16,privateRate:18,day:"Monday",start:"13:00",hours:2,flexible:true,frequency:"weekly",active:true},
  {id:"matt",name:"Matt",phone:"07886 711055",type:"Agency",rate:16,day:"Tuesday",start:"09:00",hours:4,frequency:"weekly",active:true},
  {id:"christine",name:"Christine",phone:"",type:"Private",rate:18,day:"Tuesday",start:"13:30",hours:3,frequency:"fortnightly",active:true},
  {id:"sonia",name:"Sonia",phone:"+44 7813 677012",type:"Agency",rate:16,day:"Wednesday",start:"09:00",hours:5,minimumHours:4,maximumHours:7,frequency:"weekly",active:true},
  {id:"laura",name:"Laura",phone:"+44 7958 391731",type:"Private",rate:18,day:"Thursday",start:"09:00",hours:4,frequency:"weekly",active:true},
  {id:"hannah",name:"Hannah",phone:"07920 724916",type:"Agency",rate:16,day:"Thursday",start:"13:00",hours:3,frequency:"weekly",active:true},
  {id:"meghan",name:"Meghan",phone:"+44 7740 291352",type:"Private",rate:18,day:"Thursday",start:"16:00",hours:1.5,minimumHours:1,maximumHours:2,frequency:"weekly",active:true},
  {id:"sindu",name:"Sindu",phone:"07438 168843",type:"Agency",rate:16,day:"Friday",start:"09:00",hours:3,frequency:"fortnightly",rotation:"sindu",active:true},
  {id:"joanna",name:"Joanna",phone:"07872 011386",type:"Private",rate:18,day:"Friday",start:"09:00",hours:3.5,minimumHours:3,maximumHours:4,frequency:"fortnightly",rotation:"joanna",active:true}
];

const defaultState = {
  settings:{
    appSize:1,largerText:false,highContrast:false,accent:"#e92b78",
    reminders:true,paymentReminders:true,fortnightly:true,workingHours:8,
    businessName:"Pure Shine Cleaning",ownerName:"Georgiana Radu",
    logo:DEFAULT_LOGO,banner:DEFAULT_BANNER,invoiceNumber:1
  },
  clients:DEFAULT_CLIENTS,
  jobs:[],
  holidays:[]
};

function clone(value) { return JSON.parse(JSON.stringify(value)); }

function loadState() {
  try {
    const saved = JSON.parse(localStorage.getItem("pureShineCleaningManager"));
    if (!saved) return clone(defaultState);
    const clients = saved.clients?.length ? saved.clients : clone(DEFAULT_CLIENTS);
    const mergedClients = clients.map(c => {
      const original = DEFAULT_CLIENTS.find(d => d.id === c.id);
      return original ? {...original,...c} : c;
    });
    DEFAULT_CLIENTS.forEach(d => {
      if (!mergedClients.some(c => c.id === d.id)) mergedClients.push(clone(d));
    });
    return {
      settings:{...defaultState.settings,...(saved.settings||{})},
      clients:mergedClients,
      jobs:saved.jobs||[],
      holidays:saved.holidays||[]
    };
  } catch (e) {
    return clone(defaultState);
  }
}

let state = loadState();
let calendarDate = new Date();
let selectedScheduleDate = todayKey();
let timer = {running:false,clientId:null,jobId:null,startedAt:null,interval:null};

function saveState() {
  try { localStorage.setItem("pureShineCleaningManager",JSON.stringify(state)); }
  catch(e) { showToast("Storage is full. Try using a smaller photo."); }
}

function todayKey() { return keyFromDate(new Date()); }
function keyFromDate(d) {
  return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,"0")}-${String(d.getDate()).padStart(2,"0")}`;
}
function money(v) { return "£"+Number(v||0).toFixed(2); }
function hoursToMinutes(h) { return Math.round(Number(h||0)*60); }
function minutesText(minutes) {
  minutes=Math.max(0,Math.round(Number(minutes)||0));
  const h=Math.floor(minutes/60),m=minutes%60;
  if (!h) return `${m}m`;
  if (!m) return `${h}h`;
  return `${h}h ${m}m`;
}
function escapeHTML(value) {
  return String(value??"").replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;").replace(/'/g,"&#039;");
}
function formatDate(dateString) {
  return new Date(dateString+"T12:00:00").toLocaleDateString("en-GB",{weekday:"short",day:"numeric",month:"short"});
}
function getClient(id) { return state.clients.find(c=>c.id===id); }
function getJobMinutes(job) {
  if (job.completed && job.workedMinutes!=null) return Number(job.workedMinutes);
  if (job.durationMinutes!=null) return Number(job.durationMinutes);
  return hoursToMinutes(job.hours);
}
function getJobAmount(job) { return getJobMinutes(job)/60*Number(job.rate||0); }

function isHoliday(clientId,date) {
  return state.holidays.some(h=>h.clientId===clientId && date>=h.start && date<=h.end);
}

function isFortnightlyActive(client,date) {
  if (!state.settings.fortnightly) return true;
  const reference = new Date(ROTATION_REFERENCE+"T12:00:00");
  const target = new Date(date+"T12:00:00");
  const week = Math.floor((target-reference)/604800000);
  const normalized = ((week%2)+2)%2;
  // Friday 9 October 2026 is Sindu's week; Joanna is next Friday.
  if (client.rotation==="sindu" || client.id==="sindu") return normalized===0;
  if (client.rotation==="joanna" || client.id==="joanna") return normalized===1;
  // Christine is fortnightly but has no specified rotation week yet.
  return normalized===0;
}

function isThreeWeeklyActive(client,date) {
  const reference = new Date(ROTATION_REFERENCE+"T12:00:00");
  const target = new Date(date+"T12:00:00");
  const weeks = Math.floor(Math.abs(target-reference)/604800000);
  return weeks%3===0;
}

function savedOccurrence(clientId,date) {
  return state.jobs.find(j=>j.clientId===clientId && j.date===date && j.recurring===true);
}

function generatedJobsForDate(date) {
  const day = DAYS[new Date(date+"T12:00:00").getDay()];
  const jobs = [];

  state.clients.filter(c=>c.active && c.day===day).forEach(client=>{
    if (isHoliday(client.id,date)) return;
    if (client.frequency==="occasional") return;
    if (client.frequency==="fortnightly" && !isFortnightlyActive(client,date)) return;
    if (client.frequency==="threeweekly" && !isThreeWeeklyActive(client,date)) return;

    const existing = savedOccurrence(client.id,date);
    if (existing) {
      if (!existing.deleted) jobs.push(existing);
      return;
    }

    jobs.push({
      id:"rec-"+client.id+"-"+date,
      clientId:client.id,
      date,
      start:client.start,
      hours:client.hours,
      durationMinutes:hoursToMinutes(client.hours),
      rate:client.rate,
      type:client.type,
      name:client.name,
      frequency:client.frequency,
      recurring:true,
      completed:false,
      payment:"unpaid",
      notes:""
    });
  });

  const manual = state.jobs.filter(j=>j.date===date && !j.recurring && !j.deleted);
  return [...jobs,...manual].sort((a,b)=>(a.start||"").localeCompare(b.start||""));
}

function findAnyJob(id) {
  let job=state.jobs.find(j=>j.id===id);
  if (job) return job;
  for (let offset=-370;offset<=370;offset++) {
    const d=new Date();
    d.setDate(d.getDate()+offset);
    const found=generatedJobsForDate(keyFromDate(d)).find(j=>j.id===id);
    if (found) {
      state.jobs.push(found);
      return found;
    }
  }
  return null;
}

function applySettings() {
  const s=state.settings;
  document.documentElement.style.setProperty("--pink",s.accent||"#e92b78");
  document.body.classList.toggle("larger-text",!!s.largerText);
  document.body.classList.toggle("high-contrast",!!s.highContrast);
  // Real page zoom, not just a CSS variable that has no visual effect.
  document.documentElement.style.zoom=String(Number(s.appSize)||1);
  document.getElementById("logo").src=s.logo||DEFAULT_LOGO;
  document.getElementById("banner").src=s.banner||DEFAULT_BANNER;
}

function render() {
  applySettings();
  renderHome();
  renderCalendar();
  renderSchedule();
  renderClients();
  renderEarnings();
  renderSettings();
}

function renderHome() {
  const now=new Date();
  document.getElementById("dateNumber").textContent=now.getDate();
  document.getElementById("dateDay").textContent=now.toLocaleDateString("en-GB",{weekday:"long"});
  document.getElementById("dateFull").textContent=now.toLocaleDateString("en-GB",{day:"numeric",month:"long",year:"numeric"});

  const jobs=generatedJobsForDate(todayKey());
  const completed=jobs.filter(j=>j.completed);
  document.getElementById("statJobs").textContent=completed.length;
  document.getElementById("statHours").textContent=minutesText(completed.reduce((s,j)=>s+getJobMinutes(j),0));
  document.getElementById("statMoney").textContent=money(completed.reduce((s,j)=>s+getJobAmount(j),0));
  document.getElementById("todaySchedule").innerHTML=jobs.length?jobs.map(jobCardHTML).join(""):'<div class="empty">No cleaning jobs today.</div>';
  renderTomorrow();
  renderTimerHome();
}

function renderTomorrow() {
  const d=new Date();
  d.setDate(d.getDate()+1);
  const key=keyFromDate(d);
  const jobs=generatedJobsForDate(key);
  const container=document.getElementById("tomorrowSection");
  if (!jobs.length) { container.innerHTML=""; return; }
  container.innerHTML=`<div class="tomorrow"><div class="tomorrow-title"><span>Tomorrow's Diary</span><small>${formatDate(key)}</small></div><div class="schedule">${jobs.map(jobCardHTML).join("")}</div></div>`;
}

function renderTimerHome() {
  const box=document.getElementById("activeTimerHome");
  if (!timer.running) { box.innerHTML=""; return; }
  const client=getClient(timer.clientId);
  box.innerHTML=`<div class="timer-panel"><div class="timer-client">⏱ Cleaning Timer — ${escapeHTML(client?.name||"Client")}</div><div class="timer-time" id="homeTimerDisplay">00:00:00</div><button class="btn primary" onclick="stopTimer()">■ Finish Cleaning</button></div>`;
  updateTimerDisplay();
}

function startTimer(clientId,jobId=null) {
  if (timer.running) {
    if (!confirm("A timer is already running. Finish the current job first?")) return;
    stopTimer();
    return;
  }
  timer={running:true,clientId,jobId,startedAt:Date.now(),interval:null};
  timer.interval=setInterval(updateTimerDisplay,1000);
  renderHome();
  showToast("Timer started");
}

function updateTimerDisplay() {
  if (!timer.running) return;
  const seconds=Math.floor((Date.now()-timer.startedAt)/1000);
  const display=[Math.floor(seconds/3600),Math.floor(seconds%3600/60),seconds%60].map(n=>String(n).padStart(2,"0")).join(":");
  const el=document.getElementById("homeTimerDisplay");
  if (el) el.textContent=display;
}

function stopTimer() {
  if (!timer.running) return;
  const minutes=Math.max(1,Math.round((Date.now()-timer.startedAt)/60000));
  const client=getClient(timer.clientId);
  if (!client) { clearInterval(timer.interval); timer.running=false; return; }

  let job=timer.jobId?findAnyJob(timer.jobId):null;
  if (!job) {
    job={
      id:"job-"+Date.now(),clientId:client.id,date:todayKey(),
      start:new Date(timer.startedAt).toTimeString().slice(0,5),
      rate:client.rate,type:client.type,name:client.name,
      recurring:false,payment:"unpaid"
    };
    state.jobs.push(job);
  }
  job.name=client.name;
  job.type=client.type;
  job.rate=Number(job.rate||client.rate);
  job.completed=true;
  job.workedMinutes=minutes;
  job.durationMinutes=minutes;
  job.hours=minutes/60;
  job.end=new Date().toTimeString().slice(0,5);
  job.payment=job.payment||"unpaid";

  clearInterval(timer.interval);
  timer={running:false,clientId:null,jobId:null,startedAt:null,interval:null};
  saveState();
  render();
  showToast(`${client.name}: ${minutesText(minutes)} completed`);
}

function jobCardHTML(job) {
  const minutes=getJobMinutes(job);
  const amount=getJobAmount(job);
  const completed=job.completed===true;
  const paid=job.payment==="paid";
  const safeId=escapeHTML(job.id);
  return `<div class="job-card">
    <div class="job-main">
      <div class="job-time"><strong>${escapeHTML(job.start||"09:00")}</strong><span>${minutesText(minutes)}</span></div>
      <div class="job-info">
        <div class="job-name">${escapeHTML(job.name||getClient(job.clientId)?.name||"Client")}</div>
        <div class="job-type">${escapeHTML(job.type||"Private")}${job.frequency?" • "+escapeHTML(job.frequency):""}${completed?' • <span class="job-status">Completed</span>':""}${job.flexible?' • Flexible hours':""}</div>
      </div>
      ${completed?`<div class="job-money"><strong>${money(amount)}</strong><small>${money(job.rate)}/hr</small></div>`:""}
    </div>
    <div class="job-actions">
      ${!completed?`<button class="btn timer" onclick="startTimer('${safeIdClient(job.clientId)}','${safeId}')">▶ Start</button>`:""}
      <button class="btn" onclick="editJob('${safeId}')">✏️ Edit</button>
      ${completed?`<button class="btn ${paid?"green":""}" onclick="togglePaid('${safeId}')">${paid?"✓ Paid":"£ Mark Paid"}</button><button class="btn pdf" onclick="createInvoice('${safeId}')">🧾 Invoice PDF</button>`:""}
      <button class="btn danger" onclick="deleteJob('${safeId}')">🗑 Delete</button>
    </div>
  </div>`;
}

function safeIdClient(id) { return String(id).replace(/[^a-zA-Z0-9_-]/g,""); }

function renderSchedule() {
  const jobs=generatedJobsForDate(selectedScheduleDate);
  document.getElementById("scheduleDayTitle").textContent=`Jobs — ${formatDate(selectedScheduleDate)}`;
  document.getElementById("scheduleJobs").innerHTML=jobs.length?jobs.map(jobCardHTML).join(""):'<div class="empty">No jobs scheduled for this date.</div>';
}

function renderCalendar() {
  const year=calendarDate.getFullYear(),month=calendarDate.getMonth();
  document.getElementById("monthTitle").textContent=calendarDate.toLocaleDateString("en-GB",{month:"long",year:"numeric"});
  const names=["Mon","Tue","Wed","Thu","Fri","Sat","Sun"];
  let html=names.map(n=>`<div class="calendar-day-name">${n}</div>`).join("");
  let first=new Date(year,month,1).getDay();
  first=first===0?6:first-1;
  for(let i=0;i<first;i++) html+="<div></div>";
  const days=new Date(year,month+1,0).getDate();
  for(let day=1;day<=days;day++) {
    const key=keyFromDate(new Date(year,month,day));
    const jobs=generatedJobsForDate(key);
    const holiday=state.holidays.some(h=>key>=h.start&&key<=h.end);
    html+=`<div class="calendar-day ${key===todayKey()?"today":""} ${jobs.length?"has-job":""} ${holiday?"holiday":""}" onclick="calendarDayClick('${key}')">
      <div class="calendar-day-number">${day}</div>
      ${jobs.slice(0,2).map(j=>`<div class="calendar-job-dot">${escapeHTML(j.name)}</div>`).join("")}
      ${jobs.length>2?`<div>+${jobs.length-2}</div>`:""}${holiday?"<div>🏖️</div>":""}
    </div>`;
  }
  document.getElementById("calendar").innerHTML=html;
}

function changeMonth(amount) {
  calendarDate.setMonth(calendarDate.getMonth()+amount);
  renderCalendar();
}

function calendarDayClick(date) {
  selectedScheduleDate=date;
  showPage("schedule");
  renderSchedule();
}

function openJobModal(date=todayKey()) {
  const clients=state.clients.filter(c=>c.active);
  openModal(`<div class="modal-handle"></div><h2>Add Cleaning Job</h2>
  <div class="form">
    <label>Client<select id="jobClient">${clients.map(c=>`<option value="${escapeHTML(c.id)}">${escapeHTML(c.name)} — ${money(c.rate)}/hr</option>`).join("")}</select></label>
    <div class="form-row"><label>Date<input id="jobDate" type="date" value="${date}"></label><label>Start<input id="jobStart" type="time" value="09:00"></label></div>
    <label>Planned hours<input id="jobHours" type="number" min=".25" step=".25" value="2"></label>
    <label>Notes<textarea id="jobNotes"></textarea></label>
  </div>
  <div class="modal-buttons"><button class="btn" onclick="closeModal()">Cancel</button><button class="btn primary" onclick="saveNewJob()">Add Job</button></div>`);
}

function saveNewJob() {
  const client=getClient(document.getElementById("jobClient").value);
  const date=document.getElementById("jobDate").value;
  const start=document.getElementById("jobStart").value;
  const hours=Number(document.getElementById("jobHours").value);
  if(!client||!date||!start||hours<=0) { showToast("Please complete the job details"); return; }
  state.jobs.push({id:"job-"+Date.now(),clientId:client.id,name:client.name,type:client.type,rate:client.rate,date,start,hours,durationMinutes:hoursToMinutes(hours),notes:document.getElementById("jobNotes").value,recurring:false,completed:false,payment:"unpaid"});
  saveState(); closeModal(); render(); showToast("Job added ✓");
}

function editJob(id) {
  const job=findAnyJob(id);
  if(!job) { showToast("Job not found"); return; }
  const client=getClient(job.clientId);
  openModal(`<div class="modal-handle"></div><h2>Edit Job — ${escapeHTML(job.name)}</h2>
  <div class="form">
    <label>Client<select id="editClient">${state.clients.filter(c=>c.active).map(c=>`<option value="${escapeHTML(c.id)}" ${c.id===job.clientId?"selected":""}>${escapeHTML(c.name)}</option>`).join("")}</select></label>
    <div class="form-row"><label>Date<input id="editDate" type="date" value="${job.date}"></label><label>Start<input id="editStart" type="time" value="${job.start||"09:00"}"></label></div>
    <label>Hours planned / worked<input id="editHours" type="number" min=".25" step=".25" value="${(getJobMinutes(job)/60).toFixed(2)}"></label>
    <label>Status<select id="editCompleted"><option value="false" ${!job.completed?"selected":""}>Scheduled</option><option value="true" ${job.completed?"selected":""}>Completed</option></select></label>
    <label>Payment<select id="editPayment"><option value="unpaid" ${job.payment!=="paid"?"selected":""}>Not paid</option><option value="paid" ${job.payment==="paid"?"selected":""}>Paid</option></select></label>
    <label>Notes<textarea id="editNotes">${escapeHTML(job.notes||"")}</textarea></label>
  </div>
  <div class="modal-buttons"><button class="btn" onclick="closeModal()">Cancel</button><button class="btn primary" onclick="saveEditedJob('${escapeHTML(job.id)}')">Save Changes</button></div>`);
}

function saveEditedJob(id) {
  const job=findAnyJob(id);
  const client=getClient(document.getElementById("editClient").value);
  const hours=Number(document.getElementById("editHours").value);
  const date=document.getElementById("editDate").value;
  if(!job||!client||!date||hours<=0) { showToast("Please check the job details"); return; }
  job.clientId=client.id; job.name=client.name; job.type=client.type; job.rate=client.rate;
  job.date=date; job.start=document.getElementById("editStart").value;
  job.durationMinutes=hoursToMinutes(hours); job.hours=hours;
  job.completed=document.getElementById("editCompleted").value==="true";
  job.payment=document.getElementById("editPayment").value;
  job.notes=document.getElementById("editNotes").value;
  if(job.completed) { if(!job.workedMinutes) job.workedMinutes=job.durationMinutes; }
  else delete job.workedMinutes;
  // Save this particular recurring occurrence without changing the client's regular pattern.
  job.recurring=true;
  saveState(); closeModal(); render(); showToast("Job updated ✓");
}

function deleteJob(id) {
  if(!confirm("Delete this job?")) return;
  const job=findAnyJob(id);
  if(job && job.recurring) job.deleted=true;
  state.jobs=state.jobs.filter(j=>j.id!==id);
  // A deleted recurring occurrence is retained as a tombstone so it doesn't regenerate.
  if(job && job.recurring) state.jobs.push({...job,deleted:true});
  saveState(); render(); showToast("Job deleted");
}

function togglePaid(id) {
  const job=findAnyJob(id);
  if(!job) return;
  job.payment=job.payment==="paid"?"unpaid":"paid";
  saveState(); render(); showToast(job.payment==="paid"?"Marked as paid ✓":"Marked as unpaid");
}

function renderClients() {
  const clients=state.clients.filter(c=>c.active);
  document.getElementById("clientsList").innerHTML=clients.length?clients.map(c=>`
    <div class="client-card">
      <div class="client-avatar">${escapeHTML(c.name.charAt(0).toUpperCase())}</div>
      <div class="client-info">
        <div class="client-name">${escapeHTML(c.name)}</div>
        <div class="client-details">${escapeHTML(c.type)} • ${money(c.rate)}/hr • ${escapeHTML(c.frequency)} • ${escapeHTML(c.day)} • ${escapeHTML(c.start)} • ${c.minimumHours?`${c.minimumHours}–${c.maximumHours}h flexible`:c.hours+"h"}</div>
        ${c.phone?`<div class="client-details">📞 ${escapeHTML(c.phone)}</div>`:""}
      </div>
      <div class="client-actions"><button class="btn timer" onclick="openClientTimer('${escapeHTML(c.id)}')">⏱</button><button class="btn" onclick="editClient('${escapeHTML(c.id)}')">✏️ Edit</button></div>
    </div>`).join(""):'<div class="empty">No clients yet.</div>';
}

function openClientModal() {
  openModal(`<div class="modal-handle"></div><h2>Add Client</h2><div class="form">
    <label>Client Name<input id="newClientName" placeholder="Client name"></label>
    <label>Phone Number<input id="newClientPhone" type="tel" placeholder="+44"></label>
    <label>Cleaning Day<select id="newClientDay">${DAYS.slice(1).map(d=>`<option>${d}</option>`).join("")}</select></label>
    <label>Frequency<select id="newClientFrequency"><option value="weekly">Weekly</option><option value="fortnightly">Fortnightly</option><option value="occasional">Occasional</option><option value="threeweekly">Every 3 weeks</option></select></label>
    <div class="form-row"><label>Type<select id="newClientType"><option>Private</option><option>Agency</option></select></label><label>Rate £/hour<input id="newClientRate" type="number" value="18" step=".5"></label></div>
    <div class="form-row"><label>Usual start<input id="newClientStart" type="time" value="09:00"></label><label>Usual hours<input id="newClientHours" type="number" value="2" min=".25" step=".25"></label></div>
  </div><div class="modal-buttons"><button class="btn" onclick="closeModal()">Cancel</button><button class="btn primary" onclick="saveNewClient()">Add Client</button></div>`);
}

function saveNewClient() {
  const name=document.getElementById("newClientName").value.trim();
  const phone=document.getElementById("newClientPhone").value.trim();
  const day=document.getElementById("newClientDay").value;
  if(!name||!day) { showToast("Please enter a name and cleaning day"); return; }
  state.clients.push({
    id:"client-"+Date.now(),name,phone,day,
    frequency:document.getElementById("newClientFrequency").value,
    type:document.getElementById("newClientType").value,
    rate:Number(document.getElementById("newClientRate").value||18),
    start:document.getElementById("newClientStart").value,
    hours:Number(document.getElementById("newClientHours").value||2),
    active:true
  });
  saveState(); closeModal(); render(); showToast("Client added ✓");
}

function editClient(id) {
  const c=getClient(id);
  if(!c) return;
  openModal(`<div class="modal-handle"></div><h2>Edit ${escapeHTML(c.name)}</h2><div class="form">
    <label>Client Name<input id="editClientName" value="${escapeHTML(c.name)}"></label>
    <label>Phone<input id="editClientPhone" value="${escapeHTML(c.phone||"")}"></label>
    <label>Cleaning Day<select id="editClientDay">${DAYS.slice(1).map(d=>`<option ${d===c.day?"selected":""}>${d}</option>`).join("")}</select></label>
    <label>Frequency<select id="editClientFrequency">
      <option value="weekly" ${c.frequency==="weekly"?"selected":""}>Weekly</option>
      <option value="fortnightly" ${c.frequency==="fortnightly"?"selected":""}>Fortnightly</option>
      <option value="occasional" ${c.frequency==="occasional"?"selected":""}>Occasional</option>
      <option value="threeweekly" ${c.frequency==="threeweekly"?"selected":""}>Every 3 weeks</option>
    </select></label>
    <div class="form-row"><label>Type<select id="editClientType"><option ${c.type==="Private"?"selected":""}>Private</option><option ${c.type==="Agency"?"selected":""}>Agency</option></select></label><label>Rate<input id="editClientRate" type="number" value="${c.rate}" step=".5"></label></div>
    <div class="form-row"><label>Usual start<input id="editClientStart" type="time" value="${c.start||"09:00"}"></label><label>Usual hours<input id="editClientHours" type="number" value="${c.hours}" step=".25"></label></div>
    <label>Minimum hours (optional)<input id="editClientMin" type="number" min=".25" step=".25" value="${c.minimumHours||""}"></label>
    <label>Maximum hours (optional)<input id="editClientMax" type="number" min=".25" step=".25" value="${c.maximumHours||""}"></label>
    <div class="section-title" style="font-size:17px;margin:8px 0">🏖 Holiday</div>
    <div class="form-row"><label>Holiday From<input id="holidayStart" type="date"></label><label>Holiday To<input id="holidayEnd" type="date"></label></div>
    <button class="btn" onclick="saveClientHoliday('${escapeHTML(c.id)}')">🏖 Save Holiday</button>
    <div id="clientHolidays">${renderClientHolidays(c.id)}</div>
  </div><div class="modal-buttons"><button class="btn danger" onclick="removeClient('${escapeHTML(c.id)}')">Delete Client</button><button class="btn primary" onclick="saveEditedClient('${escapeHTML(c.id)}')">Save Changes</button></div>`);
}

function saveEditedClient(id) {
  const c=getClient(id);
  if(!c) return;
  c.name=document.getElementById("editClientName").value.trim();
  c.phone=document.getElementById("editClientPhone").value.trim();
  c.day=document.getElementById("editClientDay").value;
  c.frequency=document.getElementById("editClientFrequency").value;
  c.type=document.getElementById("editClientType").value;
  c.rate=Number(document.getElementById("editClientRate").value||18);
  c.start=document.getElementById("editClientStart").value;
  c.hours=Number(document.getElementById("editClientHours").value||2);
  c.minimumHours=Number(document.getElementById("editClientMin").value)||null;
  c.maximumHours=Number(document.getElementById("editClientMax").value)||null;
  saveState(); closeModal(); render(); showToast("Client updated ✓");
}

function removeClient(id) {
  const c=getClient(id);
  if(!c||!confirm("Remove "+c.name+" from your clients?")) return;
  c.active=false;
  saveState(); closeModal(); render(); showToast("Client removed");
}

function renderClientHolidays(clientId) {
  const holidays=state.holidays.filter(h=>h.clientId===clientId);
  if(!holidays.length) return '<div class="setting-desc" style="margin-top:8px">No holidays saved.</div>';
  return holidays.map(h=>`<div style="padding:10px;margin-top:7px;background:#f5eafa;border-radius:12px">${formatDate(h.start)} → ${formatDate(h.end)} <button class="btn danger" onclick="deleteHoliday('${escapeHTML(h.id)}')">Remove</button></div>`).join("");
}

function saveClientHoliday(clientId) {
  const start=document.getElementById("holidayStart").value;
  const end=document.getElementById("holidayEnd").value;
  if(!start||!end||end<start) { showToast("Choose valid holiday dates"); return; }
  state.holidays.push({id:"holiday-"+Date.now(),clientId,start,end});
  saveState();
  const box=document.getElementById("clientHolidays");
  if(box) box.innerHTML=renderClientHolidays(clientId);
  renderCalendar();
  showToast("Holiday saved ✓");
}

function deleteHoliday(id) {
  state.holidays=state.holidays.filter(h=>h.id!==id);
  saveState(); render();
  showToast("Holiday removed");
}

function openClientTimer(clientId) {
  const c=getClient(clientId);
  if(!c) return;
  openModal(`<div class="modal-handle"></div><h2>${escapeHTML(c.name)}</h2><div class="timer-panel"><div class="timer-client">Cleaning Timer</div><div class="timer-time" id="modalTimerDisplay">00:00:00</div><button class="btn primary" onclick="closeModal();startTimer('${escapeHTML(c.id)}')">▶ Start Timer</button></div>`);
}

function renderEarnings() {
  const completed=state.jobs.filter(j=>j.completed&&!j.deleted);
  const total=completed.reduce((s,j)=>s+getJobAmount(j),0);
  const paid=completed.filter(j=>j.payment==="paid").reduce((s,j)=>s+getJobAmount(j),0);
  document.getElementById("totalEarned").textContent=money(total);
  document.getElementById("totalPaid").textContent=money(paid);
  document.getElementById("totalOwed").textContent=money(total-paid);
  document.getElementById("history").innerHTML=completed.length?completed.slice().sort((a,b)=>(b.date||"").localeCompare(a.date||"")).map(jobCardHTML).join(""):'<div class="empty">Completed jobs will appear here.</div>';
}

function setSwitch(id,value) {
  const el=document.getElementById(id);
  if(el) el.classList.toggle("on",!!value);
}

function renderSettings() {
  const s=state.settings;
  document.getElementById("scaleRange").value=s.appSize;
  document.getElementById("scaleValue").textContent=Math.round(s.appSize*100)+"%";
  document.getElementById("accentColor").value=s.accent;
  document.getElementById("businessName").value=s.businessName;
  document.getElementById("ownerName").value=s.ownerName;
  document.getElementById("workingHours").value=s.workingHours;
  setSwitch("largerTextSwitch",s.largerText);
  setSwitch("contrastSwitch",s.highContrast);
  setSwitch("reminderSwitch",s.reminders);
  setSwitch("paymentSwitch",s.paymentReminders);
  setSwitch("fortnightlySwitch",s.fortnightly);
}

function toggleSetting(key) {
  state.settings[key]=!state.settings[key];
  saveState(); applySettings(); renderSettings();
  showToast(state.settings[key]?"Setting enabled ✓":"Setting disabled");
}

document.getElementById("scaleRange").addEventListener("input",function() {
  state.settings.appSize=Number(this.value);
  document.getElementById("scaleValue").textContent=Math.round(state.settings.appSize*100)+"%";
  applySettings();
  saveState();
});

document.getElementById("accentColor").addEventListener("input",function() {
  state.settings.accent=this.value;
  applySettings();
  saveState();
});

document.getElementById("logoUpload").addEventListener("change",function() {
  changePhoto("logo",this);
});

document.getElementById("bannerUpload").addEventListener("change",function() {
  changePhoto("banner",this);
});

function saveSettings() {
  state.settings.businessName=document.getElementById("businessName").value.trim()||"Pure Shine Cleaning";
  state.settings.ownerName=document.getElementById("ownerName").value.trim()||"Georgiana Radu";
  state.settings.workingHours=Number(document.getElementById("workingHours").value);
  saveState(); render(); showToast("Settings saved ✓");
}

function changePhoto(type,input) {
  const file=input.files?.[0];
  if(!file) return;
  if(file.size>2.5*1024*1024) {
    showToast("Please choose an image smaller than 2.5 MB");
    input.value="";
    return;
  }
  const reader=new FileReader();
  reader.onload=()=>{
    state.settings[type]=reader.result;
    saveState(); applySettings();
    showToast(type==="logo"?"App icon saved ✓":"Banner saved ✓");
  };
  reader.readAsDataURL(file);
}

async function createInvoice(id) {
  const job=findAnyJob(id);
  if(!job||!job.completed) { showToast("Complete the job before creating an invoice"); return; }
  if(!window.jspdf) { alert("PDF system is loading. Please try again."); return; }
  const {jsPDF}=window.jspdf;
  const doc=new jsPDF();
  const invoiceNumber="PS-"+String(state.settings.invoiceNumber).padStart(5,"0");
  state.settings.invoiceNumber++;
  saveState();
  const client=getClient(job.clientId);
  const amount=getJobAmount(job);
  doc.setFillColor(250,226,238); doc.rect(0,0,210,42,"F");
  doc.setTextColor(155,75,111); doc.setFontSize(24); doc.text(state.settings.businessName,18,20);
  doc.setFontSize(10); doc.setTextColor(120,110,118); doc.text("PROFESSIONAL CLEANING",18,29);
  doc.setTextColor(60,55,60); doc.setFontSize(20); doc.text("INVOICE",150,20);
  doc.setFontSize(10); doc.text(invoiceNumber,150,28);
  doc.setFontSize(11); doc.text("BILL TO",18,57);
  doc.setFontSize(15); doc.text(String(job.name||""),18,66);
  if(client?.phone) { doc.setFontSize(10); doc.text(client.phone,18,73); }
  doc.setFontSize(11); doc.text("DATE",18,91);
  doc.text(formatDate(job.date),18,98);
  doc.text("CLEANING SERVICE",18,118);
  doc.text(minutesText(getJobMinutes(job))+" × "+money(job.rate)+"/hour",18,127);
  doc.line(18,139,192,139);
  doc.setFontSize(12); doc.text("TOTAL",18,153);
  doc.setFontSize(21); doc.setTextColor(155,75,111); doc.text(money(amount),150,153);
  doc.setTextColor(70,65,70); doc.setFontSize(10);
  doc.text(job.payment==="paid"?"Payment status: PAID":"Payment status: NOT PAID",18,170);
  doc.text(state.settings.ownerName,18,187);
  const filename=invoiceNumber+"-"+String(job.name||"Client").replace(/[^a-z0-9]+/gi,"-")+".pdf";
  doc.save(filename);
  showToast("Invoice PDF created ✓");
}

function openReminder() {
  const clients=state.clients.filter(c=>c.active);
  openModal(`<div class="modal-handle"></div><h2>Client Reminder</h2><div class="form">
    <label>Client<select id="reminderClient">${clients.map(c=>`<option value="${escapeHTML(c.id)}">${escapeHTML(c.name)}</option>`).join("")}</select></label>
    <label>Message<textarea id="reminderMessage">Hi, just a reminder about your upcoming cleaning with Pure Shine Cleaning. Thank you 💗</textarea></label>
  </div><div class="modal-buttons"><button class="btn" onclick="closeModal()">Cancel</button><button class="btn primary" onclick="sendReminder()">Send SMS</button></div>`);
}

function sendReminder() {
  const client=getClient(document.getElementById("reminderClient").value);
  const message=document.getElementById("reminderMessage").value;
  closeModal();
  if(client?.phone) {
    window.location.href="sms:"+encodeURIComponent(client.phone)+"?body="+encodeURIComponent(message);
  } else {
    showToast("Add a phone number to this client first");
  }
}

function showPage(page) {
  document.querySelectorAll(".page").forEach(p=>p.classList.remove("active"));
  document.getElementById(page).classList.add("active");
  document.querySelectorAll(".nav-btn").forEach(b=>b.classList.remove("active"));
  document.getElementById("nav-"+page)?.classList.add("active");
  window.scrollTo({top:0,behavior:"smooth"});
  render();
}

function openModal(html) {
  document.getElementById("modal").innerHTML=html;
  document.getElementById("modalBg").classList.add("show");
}

function closeModal() { document.getElementById("modalBg").classList.remove("show"); }
function closeModalOutside(event) { if(event.target.id==="modalBg") closeModal(); }

function showToast(message) {
  const toast=document.getElementById("toast");
  toast.textContent=message;
  toast.style.display="block";
  clearTimeout(toast._timer);
  toast._timer=setTimeout(()=>toast.style.display="none",2400);
}

document.addEventListener("visibilitychange",()=>{ if(timer.running) updateTimerDisplay(); });

applySettings();
render();
</script>
</body>
</html>
